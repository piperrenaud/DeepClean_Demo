      propertyPath: questionName
      value: Ask About Keys
      objectReference: {fileID: 0}
    - target: {fileID: 4664198891346622730, guid: 05f3013e76204b94e863675dfba4aca2, type: 3}
      propertyPath: playerDialogue
      value: "A set of storage unit keys. Its a bit worn and there\u2019s nothing
        unusual to see at a glance. Good place to hide things though..."
      objectReference: {fileID: 0}
    - target: {fileID: 4664198891346622730, guid: 05f3013e76204b94e863675dfba4aca2, type: 3}
      propertyPath: itemDescription
      value: "Keys to a storage unit. People don\u2019t hide things in storage unless
        they\u2019re worth hiding. Can\u2019t learn much from a photo \u2014 I\u2019ll
        need these in hand"
      objectReference: {fileID: 0}
