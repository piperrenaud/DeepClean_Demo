  objectID: Pants
  itemIcon: {fileID: 21300000, guid: dda52cba8e5c04e40a1e57aa35963fca, type: 3}
  questionName: Ask about bloodstained pants
  evidenceType: 2
  itemDescription: 'A pair of pants draped over a chair with a dark red stain on
    the thigh. The pattern suggests contact with blood, but the pants are too bulky
    to take. '
  playerDialogue: "Well, that\u2019s a mess. No way I\u2019m stuffing these in my
    bag, but a quick picture should keep this evidence safe."
  explanation: Wait, what pants? Just forget about those, yeah? They're from an art
    project.
  canBeInspected: 1
  isComputer: 0
  holdDistance: 2.5
  rotationSpeed: 100
  doorAnimator: {fileID: 0}
